@model nvk_2310900046_de06.Models.NvkStudent

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">📄 Thông tin chi tiết sinh viên</h4>
                </div>
                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-4">Họ tên</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NvkStudName)</dd>

                        <dt class="col-sm-4">Tuổi</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NvkStudAge)</dd>

                        <dt class="col-sm-4">Giới tính</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NvkStudGender)</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NvkEmail)</dd>

                        <dt class="col-sm-4">Tình trạng</dt>
                        <dd class="col-sm-8">
                            @(Model.NvkStudStatus == true ? "Hoạt động" : "Tạm khóa")
                        </dd>

                    </dl>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="NvkEdit" asp-route-nvkID="@Model?.NvkStudId" class="btn btn-warning">✏️ Chỉnh sửa</a>
                        <a asp-action="NvkIndex" class="btn btn-secondary">⬅ Quay lại danh sách</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
