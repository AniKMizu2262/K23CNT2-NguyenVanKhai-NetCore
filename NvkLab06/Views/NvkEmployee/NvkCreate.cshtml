@model NvkLab06.Models.NvkEmployee

@{
    ViewBag.Title = "Thêm nhân viên mới";
    Layout = "~/Views/Shared/_NvkLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">Thêm nhân viên mới</h2>

    @using (Html.BeginForm("NvkCreate", "NvkEmployee", FormMethod.Post))
    {
        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            @Html.TextBoxFor(m => m.NvkName, new { @class = "form-control", placeholder = "Nhập họ tên" })
        </div>

        <div class="mb-3">
            <label class="form-label">Ngày sinh</label>
            @Html.TextBoxFor(m => m.NvkBirthDay, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            @Html.TextBoxFor(m => m.NvkEmail, new { @class = "form-control", type = "email" })
        </div>

        <div class="mb-3">
            <label class="form-label">Điện thoại</label>
            @Html.TextBoxFor(m => m.NvkPhone, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label">Lương</label>
            @Html.TextBoxFor(m => m.NvkSalary, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label">Trạng thái</label><br />
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(m => m.NvkStatus, true, new { @class = "form-check-input", id = "active" })
                <label class="form-check-label" for="active">Đang làm</label>
            </div>
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(m => m.NvkStatus, false, new { @class = "form-check-input", id = "inactive" })
                <label class="form-check-label" for="inactive">Đã nghỉ</label>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a href="@Url.Action("NvkIndex", "NvkEmployee")" class="btn btn-secondary">Quay lại</a>
            <button type="submit" class="btn btn-success">Lưu</button>
        </div>
    }
</div>
