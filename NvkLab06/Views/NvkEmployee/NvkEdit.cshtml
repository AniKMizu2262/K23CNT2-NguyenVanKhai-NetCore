@model NvkLab06.Models.NvkEmployee

@{
    ViewData["Title"] = "Sửa thông tin nhân viên";
    Layout = "~/Views/Shared/_NvkLayout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="NvkEdit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="NvkId" type="hidden" />
    <div class="form-group">
        <label>Mã NV</label>
        <input asp-for="NvkId" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label>Họ tên</label>
        <input asp-for="NvkName" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Ngày sinh</label>
        <input asp-for="NvkBirthDay" type="date" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="NvkEmail" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Điện thoại</label>
        <input asp-for="NvkPhone" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Lương</label>
        <input asp-for="NvkSalary" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Trạng thái</label>
        <select asp-for="NvkStatus" class="form-control">
            <option value="true">Hoạt động</option>
            <option value="false">Không hoạt động</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Cập nhật</button>
    <a asp-action="NvkIndex" class="btn btn-secondary">Quay lại</a>
</form>