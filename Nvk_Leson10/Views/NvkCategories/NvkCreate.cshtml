@model Nvk_Leson10.Models.Category

@{
    ViewData["Title"] = "Thêm mới danh sách loại";
}

<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
            <form asp-action="NvkCreate">
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="CateId" class="control-label"></label>
                        <input asp-for="CateId" class="form-control" />
                        <span asp-validation-for="CateId" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CateName" class="control-label"></label>
                        <input asp-for="CateName" class="form-control" />
                        <span asp-validation-for="CateName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CateStatus" class="control-label"></label>
                        <input asp-for="CateStatus" class="form-control" />
                        <span asp-validation-for="CateStatus" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <input type="submit" value="Thêm mới" class="btn btn-primary" name="btnNvkCreate" />
                    <a asp-action="NvkIndex" class="btn btn-link">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}