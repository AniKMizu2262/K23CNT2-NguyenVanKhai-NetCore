@model Nvk_Leson10.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục loại";
}

<h1>@ViewData["Title"]</h1>

<h3>Bạn có chắc chắn muốn xóa mục này?</h3>
<div>
    <h4>Loại danh mục</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CateName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CateName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CateStatus)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CateStatus)
        </dd>
    </dl>

    <form asp-action="NvkDelete" asp-route-nvkID="@Model.CateId" method="post">
        <input type="hidden" asp-for="CateId" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="NvkIndex">Quay lại danh sách</a>
    </form>
</div>